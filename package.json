{
  "name": "month-end-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@month-end/web",
    "build": "npm run build --workspace=@month-end/web",
    "lint": "npm run lint --workspace=@month-end/web",
    "typecheck": "npm run typecheck --workspace=@month-end/web",
    "test": "npm run test --workspace=@month-end/web",
    "release:production": "node scripts/deploy-production.mjs",
    "test:module-access": "node tests/platform-module-access.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "supabase": "2.109.1"
  }
}
